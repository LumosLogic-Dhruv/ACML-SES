PORT=3000

# Note: SES SMTP creds and AWS access keys are no longer read from here.
# Each client's SMTP host/user/pass/config-set live in the api_keys table.
# CloudWatch metrics were removed in favor of SNS-driven bounce/delivery tracking.

# SES Config
SES_CONFIG_SET=
SES_DEFAULT_FROM=no-reply@yourdomain.com
SES_SEND_RATE=14
ALLOWED_FROM_DOMAINS=yourdomain.com
MAX_RECIPIENTS=10000
BULK_THRESHOLD=50

# Redis
REDIS_URL=redis://localhost:6379

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# API Keys
API_KEY=
ADMIN_KEY=

# Unsubscribe
UNSUBSCRIBE_BASE_URL=https://yourdomain.com
UNSUBSCRIBE_SECRET=
